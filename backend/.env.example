APP_ENV=development
HOST=127.0.0.1
PORT=8080

# PostgreSQL values used by the Vapor runtime and the Flyway migration container.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=shopswift_db
DATABASE_USERNAME=shopswift_user
DATABASE_PASSWORD=change_me

# Optional: if supplied, DATABASE_URL takes precedence over the individual values above.
# DATABASE_URL=postgresql://shopswift_user:change_me@localhost:5432/shopswift_db

